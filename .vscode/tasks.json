{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MicroUI UI",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/build\" && gcc -std=c99 -g3 -O0 -Wall -Wextra -I\"${workspaceFolder}/UI\" \"${workspaceFolder}/UI/main.c\" \"${workspaceFolder}/UI/microui.c\" \"${workspaceFolder}/UI/renderer.c\" -o \"${workspaceFolder}/build/microui-ui\" $(pkg-config --cflags --libs sdl2 gl)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
