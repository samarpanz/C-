{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch MicroUI UI (SDL2)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/microui-ui",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "preLaunchTask": "Build MicroUI UI",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}